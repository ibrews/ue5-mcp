    "test:live": "node --test tests/live/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "build:web": "node web/build.mjs"
  },
  "dependencies": {
    "entities": "6.0.1",
    "htmlparser2": "10.0.0",
    "ueblueprint": "3.0.0"
  },
  "license": "MIT",
