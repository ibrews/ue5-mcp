{
  "name": "@ibrews/blueprint-reader",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Read BlueprintUE links and Unreal Blueprint clipboard text as connected graphs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
